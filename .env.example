APP_ENV=development
APP_ADDR=127.0.0.1:8080
APP_PUBLIC_URL=http://localhost:3000

# Database Configuration (PostgreSQL)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgre
DB_PASSWORD=admin12345
DB_NAME=dental_lab
DB_SSLMODE=disable
DATABASE_URL=postgres://postgre:admin12345@127.0.0.1:5432/dental_lab?sslmode=disable

# JWT & Session
AUTH_JWT_SECRET=your_jwt_secret_here
AUTH_ACCESS_TTL=24h
AUTH_REFRESH_TTL=168h

# Uploads
UPLOAD_MAX_BYTES=15728640
UPLOAD_DIR=./uploads

LOG_LEVEL=info
